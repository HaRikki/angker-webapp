{
  "name": "angker-smm-panel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/predeploy.mjs && next build",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "typecheck:tests": "tsc -p tests/tsconfig.json",
    "db:push": "prisma db push",
    "db:setup": "prisma db push && prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "lucide-react": "^0.453.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "prisma": "^5.22.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.0",
    "tsx": "^4.19.0",
    "tailwindcss": "^3.4.13",
    "postcss": "^8.4.47",
    "autoprefixer": "^10.4.20",
    "@types/react-dom": "^18.3.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=18.18"
  }
}
