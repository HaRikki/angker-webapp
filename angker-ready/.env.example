# ---------- Core ----------
# PostgreSQL connection string. Tables are created automatically on build (prisma db push).
DATABASE_URL=
# At least 32 random characters: openssl rand -base64 32
SESSION_SECRET=
APP_URL=
# Public HTTPS URL of this app (required for Telegram Mini App + webhook)
# Example: https://your-domain.com
APP_ENV=development
# 32 bytes base64, encrypts provider API keys at rest: openssl rand -base64 32
PROVIDER_ENCRYPTION_KEY=
# Bearer token that protects GET /api/internal/worker: openssl rand -hex 32
CRON_SECRET=


# ---------- Google login (optional) ----------
# OAuth 2.0 Client ID (type: Web application) from Google Cloud Console.
# APIs & Services → Credentials → Create OAuth client ID → Web application
# Authorized JavaScript origins: your APP_URL (e.g. https://your-domain.com)
# Authorized redirect URIs: not required for GIS popup mode
# Leave empty to hide the Google button on login/register pages.
GOOGLE_CLIENT_ID=
# ---------- Telegram bot (Mini App + admin) ----------
# From @BotFather → your bot → API Token
TELEGRAM_BOT_TOKEN=
# Sent back by Telegram in X-Telegram-Bot-Api-Secret-Token: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated numeric Telegram user IDs (NOT usernames)
TELEGRAM_ADMIN_IDS=

# ---------- ABA KHQR (khmer-system.com merchant API) ----------
ABA_API_BASE_URL=https://khmer-system.com
ABA_MERCHANT_ID=
ABA_API_KEY=

# ---------- Tests only (never point at a real database) ----------
# The database name MUST contain the word "test"
TEST_DATABASE_URL=
